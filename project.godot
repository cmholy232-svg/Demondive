; Engine configuration file.
; Edit through the Godot editor where possible.

config_version=5

[application]

config/name="DemonDive"
config/description="Action roguelite. Design: docs/design.md"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Strings="*res://autoload/strings.gd"
Debug="*res://autoload/debug.gd"
Save="*res://autoload/save.gd"
Audio="*res://autoload/audio.gd"
Game="*res://autoload/game.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://art/fonts/Barlow-SemiBold.ttf"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadButton,"device":-1,"button_index":13,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadButton,"device":-1,"button_index":14,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadButton,"device":-1,"button_index":11,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventJoypadButton,"device":-1,"button_index":12,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true)]
}
magic={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":74), Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":true)]
}
special={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":75), Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":true)]
}
dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":76), Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":true), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":true)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":true)]
}
look_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194333)]
}
debug_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334)]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_shots"
2d_physics/layer_5="enemy_shots"
2d_physics/layer_6="one_way_platforms"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
